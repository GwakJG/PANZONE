PUBG_API_KEY=
PORT=3001

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=pubgop_user
DB_PASSWORD=
DB_NAME=pubgop

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email sending (optional — unset → dev mode, mail body logged to console only).
# Resend: sign up at resend.com, create API key (re_xxx...).
# Before a domain is verified, you can ONLY send to the email address that
# owns your Resend account. After domain verify, any address.
RESEND_API_KEY=
# Format: "Name <address@domain>". Use the default onboarding address until
# your own domain is verified in Resend.
MAIL_FROM="PanZone <onboarding@resend.dev>"
